# Environment variables for local development and deployment.
# Copy to `.env.local` and fill in. `.env.local` must never be committed.

# REQUIRED before launch. The origin used for canonical tags, the sitemap and
# Open Graph URLs. Without it every canonical points at http://localhost:3000.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=

# --- Analytics (all optional, all off by default) ---
# The site serves the UK, Singapore, Malaysia, the Philippines and the US.
# Loading a tracker before consent engages UK GDPR, so analytics stays off
# until a provider is chosen AND a consent banner gates the script.
# Allowed: none | plausible | umami | ga4
# `ga4` sets cookies before consent; it needs a consent-management platform.
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_ANALYTICS_DOMAIN=
# Must be "true" for analytics to load at all. Do not set this until a consent
# banner genuinely exists.
NEXT_PUBLIC_CONSENT_GATE=false

# --- Error monitoring (optional, off by default) ---
# First-party endpoint for the error boundary in src/app/error.tsx. No cookies,
# no identifiers.
NEXT_PUBLIC_ERROR_DSN=
